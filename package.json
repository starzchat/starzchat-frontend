    "vite": "^5.4.11",
    "tailwindcss": "^3.4.13",
    "postcss": "^8.4.49",
    "autoprefixer": "^10.4.20",
    "typescript": "^5.6.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
